
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Link {
  id          String   @id @default(cuid())
  originalUrl String
  shortCode   String   @unique
  clicks      Int      @default(0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  clickEvents Click[]
}
model Click {
  id        String   @id @default(cuid())
  linkId    String
  visitorId String?
  referrer  String?
  device    String?
  source    String?
  createdAt DateTime @default(now())

  link Link @relation(fields: [linkId], references: [id])
}